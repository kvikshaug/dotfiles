{
    "layer": "top",
    "position": "top",
    "modules-left": ["sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["privacy", "idle_inhibitor", "mpris", "wireplumber", "bluetooth", "network#eth", "network#wlan", "memory", "temperature", "battery#bat0", "battery#bat1", "clock"],
    "sway/workspaces": {
        "format": "{name}"
    },
    "sway/window": {
        "icon": false
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip-format-activated": "Idle inhibitor enabled",
        "tooltip-format-deactivated": "Idle inhibitor disabled"
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 18,
        "modules": [
            { "type": "screenshare" },
            { "type": "audio-in" }
        ]
    },
    "mpris": {
        "format": "{player} {player_icon}",
        "format-paused": "{player} {status_icon}",
        "player-icons": {
            "default": "▶"
        },
        "status-icons": {
            "paused": "⏸"
        }
    },
    "wireplumber": {
        "format": "{volume}% {icon}",
        "format-muted": "0% ",
        "format-icons": ["", "", ""],
        "max-volume": 150,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "bluetooth": {
        "format": " {status}",
        "format-no-controller": "",
        "format-disabled": "",
        "format-on": "",
        "format-connected": " {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },
    "network#eth": {
        "interface": "en*",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-disconnected": ""
    },
    "network#wlan": {
        "interface": "wlan*",
        "format-wifi": "{essid} {signalStrength}% ",
        "format-disconnected": ""
    },
    "memory": {
        "interval": 3,
        "format": "{percentage}/{swapPercentage}% ",
        "tooltip-format": "{used}/{total}G RAM\n{swapUsed}/{swapTotal}G Swap",
        "states": {
            "critical": 80
        }
    },
    "temperature": {
        "interval": 3,
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C ",
        "format": "{temperatureC}°C "
    },
    "battery#bat0": {
        "bat": "BAT0",
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon} {time}",
        "format-icons": ["", "", "", "", ""],
        "format-time": "{H}h {M}m",
        "states": {
            "critical": 20
        }
    },
    "battery#bat1": {
        "bat": "BAT1",
        "format": "{capacity}% {icon}",
        "format-discharging": "{capacity}% {icon} {time}",
        "format-icons": ["", "", "", "", ""],
        "format-time": "{H}h {M}m",
        "states": {
            "critical": 20
        }
    },
    "clock": {
        "format": "{:%Y-%m-%d %V %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    }
}
